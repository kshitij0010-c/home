<?xml version="1.0" encoding="utf-8"?>
<MPD xmlns="urn:mpeg:dash:schema:mpd:2011"
     xmlns:cenc="urn:mpeg:cenc:2013"
     type="dynamic"
     minimumUpdatePeriod="PT2S"
     timeShiftBufferDepth="PT10M"
     minBufferTime="PT2S"
     profiles="urn:mpeg:dash:profile:isoff-live:2011">
  <Period id="1" start="PT0S">
    <!-- Replace TOKEN below with a fresh __hdnea__ value from your Jio session -->
    <BaseURL>https://jiotvpllive.cdn.jio.com/bpk-tv/Disney_Channel_BTS/WDVLive/dash/?__hdnea__=TOKEN</BaseURL>

    <AdaptationSet id="1" contentType="audio" lang="hi" mimeType="audio/mp4"
                   codecs="mp4a.40.2" audioSamplingRate="48000" segmentAlignment="true">
      <AudioChannelConfiguration schemeIdUri="urn:mpeg:dash:23003:3:audio_channel_configuration:2011" value="2"/>
      <ContentProtection schemeIdUri="urn:mpeg:dash:mp4protection:2011" value="cenc"
                         cenc:default_KID="BB388508-E811-5E99-A9D4-7ADC9FF75A05"/>
      <ContentProtection schemeIdUri="urn:uuid:EDEF8BA9-79D6-4ACE-A3C8-27DCD51D21ED">
        <cenc:pssh>AAAAYXBzc2gBAAAA7e+LqXnWSs6jyCfc1R0h7QAAAAG7OIUI6BFemanUetyf91oFAAAALRIQuziFCOgRXpmp1Hrcn/daBSITMjAyNjA4MTBfNjAwMDAwMDU0OEjj3JWbBg==</cenc:pssh>
      </ContentProtection>
      <SegmentTemplate timescale="48000"
                       initialization="Disney_Channel_BTS-audio_179634_hin=179600.dash"
                       media="Disney_Channel_BTS-audio_179634_hin=179600-$Time$.dash">
        <SegmentTimeline>
          <S t="86129883790975" d="96257"/>
          <S d="96255"/><S d="95232"/><S d="96256"/>
          <!-- ... repeat the 4-tick cycle; must be refreshed from live manifest ... -->
        </SegmentTimeline>
      </SegmentTemplate>
      <Representation id="audio_179634_hin=179600" bandwidth="179600"/>
    </AdaptationSet>

    <AdaptationSet id="4" contentType="video" mimeType="video/mp4"
                   codecs="avc1.64001F" width="1024" height="576"
                   frameRate="25" segmentAlignment="true">
      <ContentProtection schemeIdUri="urn:mpeg:dash:mp4protection:2011" value="cenc"
                         cenc:default_KID="B9B687A7-C29B-51A3-9701-2E44DB459008"/>
      <ContentProtection schemeIdUri="urn:uuid:EDEF8BA9-79D6-4ACE-A3C8-27DCD51D21ED">
        <cenc:pssh>AAAAYXBzc2gBAAAA7e+LqXnWSs6jyCfc1R0h7QAAAAG5toenwptRo5cBLkTbRZAIAAAALRIQubaHp8KbUaOXAS5E20WQCCITMjAyNjA4MTBfNjAwMDAwMDU0OEjj3JWbBg==</cenc:pssh>
      </ContentProtection>
      <SegmentTemplate timescale="600"
                       initialization="Disney_Channel_BTS-video=$RepresentationID$.dash"
                       media="Disney_Channel_BTS-video=$RepresentationID$-$Time$.dash">
        <SegmentTimeline>
          <S t="1076623547381" d="1200" r="299"/>
        </SegmentTimeline>
      </SegmentTemplate>
      <Representation id="1268000" bandwidth="1268000" scanType="progressive"/>
      <Representation id="2698400" bandwidth="2698400" scanType="progressive"/>
